# Public hostname used by Caddy and the application.
DOMAIN=chat.example.com
APP_ORIGIN=https://chat.example.com

# Use a URL-safe password or percent-encode it in DATABASE_URL.
POSTGRES_DB=loci
POSTGRES_USER=loci
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://loci:CHANGE_ME@postgres:5432/loci

# Required application secrets.
SESSION_SECRET=
# Paste auth:hash-password output inside double quotes, keeping every backslash.
OWNER_PASSWORD_HASH=

# Required chat provider. The base URL defaults to the official Anthropic API.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.anthropic.com
CHAT_MODEL=

# Optional compression route. Empty fields inherit from CHAT_*.
COMPRESSION_API_KEY=
COMPRESSION_BASE_URL=
COMPRESSION_MODEL=

# Optional narrative-consolidation fallback. Empty fields inherit field-wise
# from COMPRESSION_* and then CHAT_*. A candidate equal to the primary chat
# endpoint and model is skipped.
CONSOLIDATION_API_KEY=
CONSOLIDATION_BASE_URL=
CONSOLIDATION_MODEL=

# Optional memory-extraction route. Empty fields inherit field-wise from
# COMPRESSION_* and then CHAT_*.
EXTRACTION_API_KEY=
EXTRACTION_BASE_URL=
EXTRACTION_MODEL=

# Optional for chat, required for semantic memory retrieval and client tools.
# Configure all four values together; dimensions must match vector(1536).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
